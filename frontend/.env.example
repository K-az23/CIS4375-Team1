# Copy this file to ".env" and fill in the real values.
# Vite only reads variables that start with VITE_. Restart "npm run dev" after editing.

# Where the back-end server runs
VITE_API_URL=http://localhost:3000

# S3 folder that holds the site photos (no slash at the end).
# Leave blank to use the local copies in public/images.
VITE_IMAGE_BASE_URL=

# Demo mode: shows "Client dashboard" / "Owner dashboard" buttons on the login page
# so you can preview both without an account. Only works with "npm run dev".
VITE_DEMO_AUTH=false