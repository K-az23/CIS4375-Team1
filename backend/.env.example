CLIENT_URL=http://localhost:5173

DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=capstone
DB_USER=your-db-username
DB_PASSWORD=your-db-password


JWT_SECRET_KEY=replace-with-a-secure-random-value # to sign and verify login/access JWTs
SECRET_KEY=replace-with-a-secure-random-value # to sign and verify password-reset tokens
